tests {
  let b = res.getBody();
  test("CT-22b | status 405", () => { expect(res.getStatus()).to.equal(405); });
  test("CT-22b | erro.codigo = METODO_NAO_PERMITIDO", () => { expect(b, 'corpo não é JSON').to.be.an('object'); expect(b.erro.codigo).to.eql("METODO_NAO_PERMITIDO"); });
  test("CT-22b | erro.mensagem presente", () => { expect(b.erro.mensagem).to.be.a('string').and.not.empty; });
}


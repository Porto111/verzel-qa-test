meta {
  name: CT-26 | CEP com 8 dígitos sem hífen é aceito
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/pedidos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "cliente": {
      "nome": "Maria Silva",
      "email": "maria@exemplo.com",
      "cep": "01310100"
    },
    "itens": [
      {
        "produtoId": "P005",
        "quantidade": 1
      }
    ]
  }
}

tests {
  let b = res.getBody();
  test("CT-26 | status 201", () => { expect(res.getStatus()).to.equal(201); });
  test("CT-26 | CEP mantido sem hífen", () => { expect(b.cliente.cep).to.eql('01310100'); });
}

docs {
  ## CT-26 | CEP com 8 dígitos sem hífen é aceito


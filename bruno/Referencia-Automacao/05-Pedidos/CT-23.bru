meta {
  name: CT-23 | Pedido válido com cupom BEMVINDO10
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/pedidos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "cliente": {
      "nome": "Maria Silva",
      "email": "maria@exemplo.com",
      "cep": "01310-100"
    },
    "itens": [
      {
        "produtoId": "P005",
        "quantidade": 1
      }
    ],
    "cupom": "BEMVINDO10"
  }
}

tests {
  let b = res.getBody();
  test("CT-23 | status 201", () => { expect(res.getStatus()).to.equal(201); });
  test("CT-23 | número no formato VZ-000000", () => { expect(b.numero).to.match(/^VZ-\d{6}$/); });
  test("CT-23 | CEP normalizado (01310100)", () => { expect(b.cliente.cep).to.eql('01310100'); });
  test("CT-23 | valores do resumo", () => { expect(b).to.include({subtotal:100, desconto:10, frete:19.9, freteGratis:false, valorFaltanteFreteGratis:100, total:109.9}); });
  test("CT-23 | cupom aplicado", () => { expect(b.cupom.aplicado).to.eql(true); });
  bru.setVar('ultimoPedido', b && b.numero);
}

docs {
  ## CT-23 | Pedido válido com cupom BEMVINDO10

  **Regra:** Pedido  
  **Camada:** API – referência (já coberto pela automação Playwright)

  ### Como executar
  - Selecione o environment **Verzel Store** e clique em **Send** (Ctrl+Enter).
  - Compare a resposta com o resultado esperado e confira a aba **Tests**.
  - Use esta requisição para **repetir manualmente** uma falha da automação antes de abrir bug.

  ### Resultado esperado
  - status 201
  - número no formato VZ-000000
  - CEP normalizado (01310100)
  - valores do resumo
  - cupom aplicado

}


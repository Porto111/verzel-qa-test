meta {
  name: CT-14b | Pedido com 6 unidades (CA10 vale na API)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/pedidos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "cliente": {
      "nome": "Maria Silva",
      "email": "maria@exemplo.com",
      "cep": "01310-100"
    },
    "itens": [
      {
        "produtoId": "P004",
        "quantidade": 6
      }
    ]
  }
}

tests {
  let b = res.getBody();
  test("CT-14b | status 422", () => { expect(res.getStatus()).to.equal(422); });
  test("CT-14b | erro.codigo = QUANTIDADE_MAXIMA_EXCEDIDA", () => { expect(b, 'corpo não é JSON').to.be.an('object'); expect(b.erro.codigo).to.eql("QUANTIDADE_MAXIMA_EXCEDIDA"); });
  test("CT-14b | erro.mensagem presente", () => { expect(b.erro.mensagem).to.be.a('string').and.not.empty; });
}

docs {
  ## CT-14b | Pedido com 6 unidades (CA10 vale na API)

  **Regra:** CA10  
  **Camada:** API – referência (já coberto pela automação Playwright)


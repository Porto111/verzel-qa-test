tests {
  let b = res.getBody();
  test("CT-25d | status 422", () => { expect(res.getStatus()).to.equal(422); });
  test("CT-25d | erro.codigo = DADOS_INVALIDOS", () => { expect(b, 'corpo não é JSON').to.be.an('object'); expect(b.erro.codigo).to.eql("DADOS_INVALIDOS"); });
  test("CT-25d | erro.mensagem presente", () => { expect(b.erro.mensagem).to.be.a('string').and.not.empty; });
}

docs {
  ## CT-25d | Cliente inválido: CEP com letras


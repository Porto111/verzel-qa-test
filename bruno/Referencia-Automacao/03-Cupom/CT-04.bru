}

tests {
  let b = res.getBody();
  test("CT-04 | status 200", () => { expect(res.getStatus()).to.equal(200); });
  test("CT-04 | corpo é JSON", () => { expect(b, 'corpo não é JSON').to.be.an('object'); });
  test("CT-04 | subtotal = 100", () => { expect(b.subtotal).to.eql(100); });
  test("CT-04 | desconto = 0", () => { expect(b.desconto).to.eql(0); });
  test("CT-04 | frete = 19.9", () => { expect(b.frete).to.eql(19.9); });
  test("CT-04 | freteGratis = false", () => { expect(b.freteGratis).to.eql(false); });
  test("CT-04 | valorFaltanteFreteGratis = 100", () => { expect(b.valorFaltanteFreteGratis).to.eql(100); });
  test("CT-04 | total = 119.9", () => { expect(b.total).to.eql(119.9); });
  test("CT-04 | cupom.aplicado = false", () => { expect(b.cupom.aplicado).to.eql(false); });
  test("CT-04 | cupom.mensagem = Cupom inválido.", () => { expect(b.cupom.mensagem).to.eql("Cupom inválido."); });
}


meta {
  name: CT-02a | Cupom em minúsculas (bemvindo10)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/carrinho/calcular
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "itens": [
      {
        "produtoId": "P005",
        "quantidade": 1
      }
    ],
    "cupom": "bemvindo10"
  }
}

tests {
  let b = res.getBody();
  test("CT-02a | status 200", () => { expect(res.getStatus()).to.equal(200); });
  test("CT-02a | corpo é JSON", () => { expect(b, 'corpo não é JSON').to.be.an('object'); });
  test("CT-02a | subtotal = 100", () => { expect(b.subtotal).to.eql(100); });
  test("CT-02a | desconto = 10", () => { expect(b.desconto).to.eql(10); });
  test("CT-02a | frete = 19.9", () => { expect(b.frete).to.eql(19.9); });
  test("CT-02a | freteGratis = false", () => { expect(b.freteGratis).to.eql(false); });
  test("CT-02a | valorFaltanteFreteGratis = 100", () => { expect(b.valorFaltanteFreteGratis).to.eql(100); });
  test("CT-02a | total = 109.9", () => { expect(b.total).to.eql(109.9); });
  test("CT-02a | cupom.aplicado = true", () => { expect(b.cupom.aplicado).to.eql(true); });
}

docs {
  ## CT-02a | Cupom em minúsculas (bemvindo10)

  **Regra:** CA02  
  **Camada:** API – referência (já coberto pela automação Playwright)

  ### Como executar

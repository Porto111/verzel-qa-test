tests {
  let b = res.getBody();
  test("CT-15c | status 422", () => { expect(res.getStatus()).to.equal(422); });
  test("CT-15c | erro.codigo = QUANTIDADE_INVALIDA", () => { expect(b, 'corpo não é JSON').to.be.an('object'); expect(b.erro.codigo).to.eql("QUANTIDADE_INVALIDA"); });
  test("CT-15c | erro.mensagem presente", () => { expect(b.erro.mensagem).to.be.a('string').and.not.empty; });
}

docs {
  ## CT-15c | Quantidade 1.5


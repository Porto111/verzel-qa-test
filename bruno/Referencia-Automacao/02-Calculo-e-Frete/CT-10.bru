meta {
  name: CT-10 | Frete grátis considera o subtotal ANTES do cupom (P005x2 + cupom)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/carrinho/calcular
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "itens": [
      {
        "produtoId": "P005",
        "quantidade": 2
      }
    ],
    "cupom": "BEMVINDO10"
  }
}

tests {
  let b = res.getBody();
  test("CT-10 | status 200", () => { expect(res.getStatus()).to.equal(200); });
  test("CT-10 | corpo é JSON", () => { expect(b, 'corpo não é JSON').to.be.an('object'); });
  test("CT-10 | subtotal = 200", () => { expect(b.subtotal).to.eql(200); });
  test("CT-10 | desconto = 20", () => { expect(b.desconto).to.eql(20); });
  test("CT-10 | frete = 0", () => { expect(b.frete).to.eql(0); });
  test("CT-10 | freteGratis = true", () => { expect(b.freteGratis).to.eql(true); });
  test("CT-10 | valorFaltanteFreteGratis = 0", () => { expect(b.valorFaltanteFreteGratis).to.eql(0); });
  test("CT-10 | total = 180", () => { expect(b.total).to.eql(180); });
  test("CT-10 | cupom.aplicado = true", () => { expect(b.cupom.aplicado).to.eql(true); });
}

docs {
  ## CT-10 | Frete grátis considera o subtotal ANTES do cupom (P005x2 + cupom)


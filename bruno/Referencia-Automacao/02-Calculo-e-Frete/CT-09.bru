meta {
  name: CT-09 | Subtotal 199,80 (logo abaixo do limite) cobra frete (P001 + P002)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/carrinho/calcular
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "itens": [
      {
        "produtoId": "P001",
        "quantidade": 1
      },
      {
        "produtoId": "P002",
        "quantidade": 1
      }
    ]
  }
}

tests {
  let b = res.getBody();
  test("CT-09 | status 200", () => { expect(res.getStatus()).to.equal(200); });
  test("CT-09 | corpo é JSON", () => { expect(b, 'corpo não é JSON').to.be.an('object'); });
  test("CT-09 | subtotal = 199.8", () => { expect(b.subtotal).to.eql(199.8); });
  test("CT-09 | desconto = 0", () => { expect(b.desconto).to.eql(0); });
  test("CT-09 | frete = 19.9", () => { expect(b.frete).to.eql(19.9); });
  test("CT-09 | freteGratis = false", () => { expect(b.freteGratis).to.eql(false); });
  test("CT-09 | valorFaltanteFreteGratis = 0.2", () => { expect(b.valorFaltanteFreteGratis).to.eql(0.2); });
  test("CT-09 | total = 219.7", () => { expect(b.total).to.eql(219.7); });
}


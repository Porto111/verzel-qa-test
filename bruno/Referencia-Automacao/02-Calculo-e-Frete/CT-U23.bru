meta {
  name: CT-U23 | P004 + P008 + cupom: 99,90 / -9,99 / 19,90 / 109,81
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/carrinho/calcular
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "itens": [
      {
        "produtoId": "P004",
        "quantidade": 1
      },
      {
        "produtoId": "P008",
        "quantidade": 1
      }
    ],
    "cupom": "BEMVINDO10"
  }
}

tests {
  let b = res.getBody();
  test("CT-U23 | status 200", () => { expect(res.getStatus()).to.equal(200); });
  test("CT-U23 | corpo é JSON", () => { expect(b, 'corpo não é JSON').to.be.an('object'); });
  test("CT-U23 | subtotal = 99.9", () => { expect(b.subtotal).to.eql(99.9); });
  test("CT-U23 | desconto = 9.99", () => { expect(b.desconto).to.eql(9.99); });
  test("CT-U23 | frete = 19.9", () => { expect(b.frete).to.eql(19.9); });
  test("CT-U23 | freteGratis = false", () => { expect(b.freteGratis).to.eql(false); });
  test("CT-U23 | valorFaltanteFreteGratis = 100.1", () => { expect(b.valorFaltanteFreteGratis).to.eql(100.1); });
  test("CT-U23 | total = 109.81", () => { expect(b.total).to.eql(109.81); });
  test("CT-U23 | cupom.aplicado = true", () => { expect(b.cupom.aplicado).to.eql(true); });
}


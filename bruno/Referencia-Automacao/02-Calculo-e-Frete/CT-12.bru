meta {
  name: CT-12 | Arredondamento em 2 casas (P001x3 + cupom)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/carrinho/calcular
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "itens": [
      {
        "produtoId": "P001",
        "quantidade": 3
      }
    ],
    "cupom": "BEMVINDO10"
  }
}

tests {
  let b = res.getBody();
  test("CT-12 | status 200", () => { expect(res.getStatus()).to.equal(200); });
  test("CT-12 | corpo é JSON", () => { expect(b, 'corpo não é JSON').to.be.an('object'); });
  test("CT-12 | subtotal = 179.7", () => { expect(b.subtotal).to.eql(179.7); });
  test("CT-12 | desconto = 17.97", () => { expect(b.desconto).to.eql(17.97); });
  test("CT-12 | frete = 19.9", () => { expect(b.frete).to.eql(19.9); });
  test("CT-12 | freteGratis = false", () => { expect(b.freteGratis).to.eql(false); });
  test("CT-12 | valorFaltanteFreteGratis = 20.3", () => { expect(b.valorFaltanteFreteGratis).to.eql(20.3); });
  test("CT-12 | total = 181.63", () => { expect(b.total).to.eql(181.63); });
  test("CT-12 | cupom.aplicado = true", () => { expect(b.cupom.aplicado).to.eql(true); });
}


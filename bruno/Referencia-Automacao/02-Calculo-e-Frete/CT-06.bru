meta {
  name: CT-06 | Abaixo de R$ 200: frete fixo e faltante (P005x1)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/carrinho/calcular
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "itens": [
      {
        "produtoId": "P005",
        "quantidade": 1
      }
    ]
  }
}

tests {
  let b = res.getBody();
  test("CT-06 | status 200", () => { expect(res.getStatus()).to.equal(200); });
  test("CT-06 | corpo é JSON", () => { expect(b, 'corpo não é JSON').to.be.an('object'); });
  test("CT-06 | subtotal = 100", () => { expect(b.subtotal).to.eql(100); });
  test("CT-06 | desconto = 0", () => { expect(b.desconto).to.eql(0); });
  test("CT-06 | frete = 19.9", () => { expect(b.frete).to.eql(19.9); });
  test("CT-06 | freteGratis = false", () => { expect(b.freteGratis).to.eql(false); });
  test("CT-06 | valorFaltanteFreteGratis = 100", () => { expect(b.valorFaltanteFreteGratis).to.eql(100); });
  test("CT-06 | total = 119.9", () => { expect(b.total).to.eql(119.9); });
}


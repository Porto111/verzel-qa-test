tests {
  let b = res.getBody();
  test("CT-U24 | status 200", () => { expect(res.getStatus()).to.equal(200); });
  test("CT-U24 | corpo é JSON", () => { expect(b, 'corpo não é JSON').to.be.an('object'); });
  test("CT-U24 | subtotal = 849.4", () => { expect(b.subtotal).to.eql(849.4); });
  test("CT-U24 | desconto = 84.94", () => { expect(b.desconto).to.eql(84.94); });
  test("CT-U24 | frete = 0", () => { expect(b.frete).to.eql(0); });
  test("CT-U24 | freteGratis = true", () => { expect(b.freteGratis).to.eql(true); });
  test("CT-U24 | valorFaltanteFreteGratis = 0", () => { expect(b.valorFaltanteFreteGratis).to.eql(0); });
  test("CT-U24 | total = 764.46", () => { expect(b.total).to.eql(764.46); });
  test("CT-U24 | cupom.aplicado = true", () => { expect(b.cupom.aplicado).to.eql(true); });
}

